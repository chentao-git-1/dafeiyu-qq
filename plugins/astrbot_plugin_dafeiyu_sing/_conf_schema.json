{
  "enabled": {"type":"bool","description":"启用唱歌（填好 MiMo 密钥后开启）","default":false},
  "api_key": {"type":"string","description":"小米 MiMo API Key","secret":true,"default":""},
  "voice": {"type":"string","description":"唱歌女声音色","default":"茉莉","options":["冰糖","茉莉"]},
  "allowed_groups": {"type":"list","description":"允许唱歌的 QQ 群","default":["7000000101","7000000102"]},
